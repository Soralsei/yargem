pub async fn execute_prefixed(cpu: &mut CpuTask, opcode: u8) {
    match opcode {
{%- for a in prefixed %}
        0x{{ a.code }} =>
{%- if a.body | length == 0 %} {} // {{ a.mnemonic }}
{%- elif a.body | length == 1 %} { {{ a.body | first }} } // {{ a.mnemonic }}
{%- else %} { // {{ a.mnemonic }}
{%- for l in a.body %}
            {{ l }}
{%- endfor %}
        }
{%- endif %}
{%- endfor %}
        _ => { cpu.illegal().await; }
    }
}

